# ---------------------------------------------------------------------------
# DOUHC — Dennis Osadebay University Health Center
# Environment variable template. Copy to `.env.local` and fill in real values.
# NEVER commit real secrets. NEVER expose service-role keys to the browser.
# ---------------------------------------------------------------------------

# --- Supabase (public, safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, NEVER expose to the browser) ---
# Used only in server components / route handlers / server actions.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---
# Public base URL of the deployed app (used for links in emails, redirects).
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Automation / Google Apps Script bridge ---
# Shared secret the Next.js app and Google Apps Script use to authenticate
# server-to-server automation calls. Generate a long random string.
CRON_SECRET=

# ---------------------------------------------------------------------------
# NOTE: Termii SMS credentials do NOT belong here.
# They live inside the Google Apps Script "DOUHC Notification Engine" project,
# configured via PropertiesService (Script Properties). See:
#   docs/google-apps-script.md
#   docs/termii.md
# ---------------------------------------------------------------------------
